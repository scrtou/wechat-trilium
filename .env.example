# 微信公众号
WECHAT_TOKEN=change-me-random-token
WECHAT_APP_ID=wx-your-app-id
WECHAT_APP_SECRET=put-your-app-secret-here

# 明文模式留空
WECHAT_AES_KEY=

# TriliumNext
TRILIUM_BASE_URL=https://trilium.example.com
TRILIUM_ETAPI_TOKEN=put-your-etapi-token-here

# journal = 保存到 Trilium Journal 当天 Day Note
# note    = 保存到指定父 Note 下的日期目录
TRILIUM_TARGET_MODE=journal

# 只有 TRILIUM_TARGET_MODE=note 时需要
TRILIUM_PARENT_NOTE_ID=

# 服务监听
BIND_HOST=127.0.0.1
PORT=8000

GUNICORN_WORKERS=1
GUNICORN_THREADS=4
SAVE_WORKERS=2

ARCHIVE_TIMEZONE=Asia/Shanghai

OWNER_OPENIDS=your-openid
PROCESS_OWNER_ONLY=true

REPLY_TO_OWNER=false
SHOW_MESSAGE_METADATA=false
